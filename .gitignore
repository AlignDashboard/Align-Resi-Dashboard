__pycache__/
*.py[cod]
.DS_Store

# Pipeline outputs with unit- or resident-level detail. These are regenerated
# from the Drive reports on every run, so there is no reason to commit them —
# and every reason not to, since git history is forever.
# (data/*/expense_ratio.json IS tracked: build_metrics reads it back as the
# accumulated rolling-T12 series, and it holds aggregate ratios only.)
data/*/rent_roll.json
data/*/delinquency.json

# Raw reports fetched from Drive. These are the originals and contain tenant
# names — they must never be committed. The pipeline reads them and throws them
# away; only scrubbed aggregates are kept.
_downloads/

# Test fixtures are lifted from the analyst workbook and carry real names.
tests/fixtures/

# Source workbooks and reports carry everything, including names.
*.xlsx
*.xlsm
*.csv

# clasp writes this at deploy time; it carries the Apps Script project id
.clasp.json
config/drive_folders.local.json
build/

# Per-machine Claude Code settings (tool allowlists and the like). Machine
# state, not project config -- the shared half belongs in .claude/settings.json.
.claude/settings.local.json

# Browser-verification tooling. Driving docs/ in a real browser (the check
# CLAUDE.md asks for on any UI change) means installing Playwright, and npm
# puts it wherever it was run -- docs/node_modules, which Pages would then
# publish. Test dependency, never project code.
node_modules/

# Rebuilt from OPEN_ITEMS.md on every run; the state file beside it is tracked
open_items_digest.pdf

# Sealed data (scripts/crypto_data.py). What is committed is <name>.enc; these are
# the plaintext working copies, opened from it on a machine that has the password.
# The repository is public, so committing one would hand over every figure the
# sealing protects. Open them with:  python3 scripts/crypto_data.py decrypt
docs/metrics.json
docs/landing.json
docs/scorecard.json
docs/lineage.json
data/**/*.json
# per-checkout record of which sealed copy each working copy was opened from
.sealed-state.json
